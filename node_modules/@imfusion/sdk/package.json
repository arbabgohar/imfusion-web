{
  "name": "@imfusion/sdk",
  "version": "1.4.0",
  "description": "ImFusion Web SDK - Medical image processing and visualization",
  "homepage": "https://docs.imfusion.com/websdk",
  "author": "ImFusion GmbH",
  "license": "SEE LICENSE IN LICENSE.txt",
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./bindings": {
      "import": "./wasm/ImFusionLib.js",
      "types": "./wasm/ImFusionLib.d.ts"
    }
  },
  "scripts": {
    "prebuild": "tsc --noEmit -p tsconfig.json",
    "build": "tsc -p tsconfig.build.json",
    "prepack": "npm run build",
    "test": "vitest",
    "test:wrapper": "vitest test/sdk/wrapper",
    "test:bindings": "vitest test/sdk/bindings",
    "test:lib": "vitest -t 'ImFusionLib Tests'",
    "test:ci": "vitest run --coverage --reporter=default --reporter=junit --outputFile=reports/vitest.junit.xml",
    "test:update-refs": "IMFUSION_UPDATE_REFERENCES=true vitest run",
    "posttest:ci": "tsx -- ../coverage/parse-coverage.ts",
    "license": "tsx -- scripts/license.ts"
  },
  "files": [
    "dist/**",
    "wasm/ImFusionLib.js",
    "wasm/ImFusionLib.wasm",
    "wasm/ImFusionLib.d.ts",
    "LICENSE.txt",
    "Changelog.md"
  ],
  "devDependencies": {
    "@noble/ed25519": "^3.1.0",
    "@noble/hashes": "^2.3.0",
    "@types/node": "^24.1.0",
    "@vitest/browser-playwright": "4.1.10",
    "@vitest/coverage-v8": "4.1.10",
    "commander": "^14.0.0",
    "playwright": "1.62.1",
    "prettier": "^3.6.2",
    "serve-static": "^2.2.0",
    "tsx": "^4.19.2",
    "typescript": "^6.0.3"
  }
}
